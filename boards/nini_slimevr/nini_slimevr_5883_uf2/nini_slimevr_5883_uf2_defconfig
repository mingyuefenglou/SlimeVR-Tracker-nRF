CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="SlimeVR"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="NiNi_Unicorn & MINGYUE Smol SlimeVR"

CONFIG_BATTERY_USE_REG_BUCK_MAPPING=y
CONFIG_SENSOR_ROTATION_0=y

# ODR：请求 400Hz → 芯片向上取整 500Hz（ICM-42x/45x 码表无 400 档，VQF 按
# actual_time 步进）。⚠️ 40608/42686 的 AAF/UI 滤波档位以 500Hz 为前提选定
# （AAF 213Hz < 奈奎斯特 250Hz、UI gyro ODR/16≈31Hz）——改此值须重算滤波档。
CONFIG_SENSOR_ACCEL_ODR=400
CONFIG_SENSOR_GYRO_ODR=400
# 磁力计 100Hz：QMC5883P 推荐工作点（Normal 模式电流随 ODR 上涨，200Hz 徒增功耗）
CONFIG_SENSOR_MAG_ODR=100

# 传感器驱动白名单（MINIMAL + 按需逐款开启；红线不关：校准/VQF/TCAL）
CONFIG_SENSOR_IMU_DRIVERS_MINIMAL=y
CONFIG_SENSOR_MAG_DRIVERS_MINIMAL=y
CONFIG_SENSOR_DRV_ICM42688=y
CONFIG_SENSOR_DRV_ICM42686=y
CONFIG_SENSOR_DRV_ICM45686=y
CONFIG_SENSOR_DRV_LSM6DSV=y
CONFIG_SENSOR_DRV_ICM40608=y
CONFIG_SENSOR_DRV_QMC5883L=y
CONFIG_SENSOR_DRV_QMC5883P=y
CONFIG_SENSOR_DRV_QMC6309=y
CONFIG_SENSOR_DRV_MMC5603NJ=y
CONFIG_SENSOR_DRV_MMC5983MA=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0x621e937a"
